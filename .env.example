# Copy to .env and replace every value. Never commit .env.
# Password for the restricted relief_app database role used by api, worker and bot.
APP_DB_PASSWORD=change-me
# HMAC key for pseudonymizing sender IDs. Changing it breaks duplicate and rate-limit history.
SENDER_HASH_SECRET=change-me
# Signing key for login tokens (used from Phase C).
JWT_SECRET=change-me
# Leave empty to run without the Telegram bot.
TELEGRAM_BOT_TOKEN=
